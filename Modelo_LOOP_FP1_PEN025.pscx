    <Definition classid="UserCmpDefn" name="datatap" url="" view="false" instances="0" date="0" crc="120951327" id="147422521" group="Miscellaneous">
      <paramlist>
        <param name="Description" value="Scalar/Array Tap" />
      </paramlist>
      <form name="Scalar/Array Tap" w="280" h="420" splitter="70" commentlines="4">
        <category name="Configuration" visible="true">
          <parameter name="Name" desc="Name for Identification" type="Text" group="" helpmode="Overwrite" allowemptystr="true">
            <value><![CDATA[]]></value>
            <cond type="Enable"><![CDATA[true]]></cond>
            <help><![CDATA[Enter a name for identification]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
          </parameter>
          <parameter type="Integer" name="Index" desc="Start at Index Number" content_type="Literal" min="1" max="999" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond type="Enable" />
            <help><![CDATA[Starting index of sub-array or the index of the scalar output]]></help>
          </parameter>
          <parameter type="Integer" name="Dim" desc="Dimension (Enter 1 for Scalar)" content_type="Literal" min="1" max="999" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Choice" name="Type" desc="Input Data Type" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[2]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select from Logical, Integer, Real or Complex]]></help>
            <choice><![CDATA[0 = Logical]]></choice>
            <choice><![CDATA[1 = Integer]]></choice>
            <choice><![CDATA[2 = Real]]></choice>
            <choice><![CDATA[3 = Complex]]></choice>
          </parameter>
          <parameter type="Choice" name="Style" desc="Line Style" group="" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select straight line or arc]]></help>
            <choice><![CDATA[0 = Straight Line]]></choice>
            <choice><![CDATA[1 = Arc]]></choice>
          </parameter>
          <parameter type="Choice" name="Disp" desc="Display Index?" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[1]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select Yes to display index]]></help>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
          </parameter>
          <cond><![CDATA[true]]></cond>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200">
        <port model="Transfer" name="A" x="-18" y="-18" dim="0" mode="Input" type="Logical"><![CDATA[(Type==0)]]></port>
        <port model="Transfer" name="A" x="-18" y="-18" dim="0" mode="Input" type="Integer"><![CDATA[(Type==1)]]></port>
        <port model="Transfer" name="A" x="-18" y="-18" dim="0" mode="Input" type="Real"><![CDATA[(Type==2)]]></port>
        <port model="Transfer" name="B:Dim" x="0" y="0" dim="0" mode="Output" type="Logical"><![CDATA[(Type==0)]]></port>
