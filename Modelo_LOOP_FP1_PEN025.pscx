      <form name="Current Scaling" splitter="60" w="320" h="400" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
          <parameter desc="Scaling Factor" name="G_CDCS" group="" unit="" min="-1E+308" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1.0]]></value>
            <cond type="Enable"><![CDATA[]]></cond>
            <help><![CDATA[The magnitude of the source current will be the measured current multiplied by this value.]]></help>
            <vis />
          </parameter>
          <parameter name="Dim" desc="Single or Three Phase" type="Choice" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Select Single phase or Three phase]]></help>
            <choice><![CDATA[1 = Single phase]]></choice>
            <choice><![CDATA[3 = Three phase]]></choice>
          </parameter>
        </category>
      </form>
    </Definition>
    <Definition classid="UserCmpDefn" name="mux_array" url="" view="false" instances="0" date="0" crc="40674845" id="1626762887" group="CSMF">
      <paramlist>
        <param name="Description" value="N channel multiplexer" />
      </paramlist>
      <form name="12 Channel Multiplexer" w="280" h="420" splitter="70" commentlines="4">
        <category name="Configuration" visible="true">
          <cond />
          <parameter name="Name" desc="Name for Identification" type="Text" group="" helpmode="Overwrite" allowemptystr="true">
            <value><![CDATA[]]></value>
            <cond type="Enable"><![CDATA[true]]></cond>
            <help><![CDATA[Enter a name for identification]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
          </parameter>
          <parameter type="Choice" name="DPath" desc="Data Path Type:" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[0]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select the data type: real, integer or complex]]></help>
            <choice><![CDATA[0 = Integer]]></choice>
            <choice><![CDATA[1 = Real]]></choice>
            <choice><![CDATA[2 = Complex]]></choice>
          </parameter>
          <parameter desc="Output Dimension" name="Dim" group="" unit="" min="2" max="2147483647" content_type="Literal" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[12]]></value>
            <cond type="Enable" />
            <help><![CDATA[Enter the dimension of the output]]></help>
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200">
        <paramlist>
          <param name="show_grid" value="0" />
