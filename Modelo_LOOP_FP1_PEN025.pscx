        <cond><![CDATA[(Style==0)&&(Type==1)]]></cond>
        <line x1="0" y1="0" x2="-18" y2="-18" stroke="Blue" stroke-dasharray="none" stroke-width="0.2" />
        <cond><![CDATA[(Style==1)&&(Type==1)]]></cond>
        <path d="M0.000 0.000 A24 18 0 0 0 -19.832 -17.727" arc="-48,-18,0,18,0,80" stroke="Blue" stroke-dasharray="none" stroke-width="0.2" />
        <cond><![CDATA[(Style==0)&&(Type==2)]]></cond>
