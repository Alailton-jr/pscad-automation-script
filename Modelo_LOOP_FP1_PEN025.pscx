        <cond><![CDATA[(Disp==1)&&(Dim==1)]]></cond>
        <text x="-12" y="-3" stroke="Black" fill="Black" font-size="Small" text-anchor="Middle"><![CDATA[%Index]]></text>
        <cond><![CDATA[(Disp==1)&&(Dim!=1)]]></cond>
        <text x="-12" y="-3" stroke="Black" fill="Black" font-size="Small" text-anchor="Middle"><![CDATA[$Index to $End]]></text>
      </svg>
      <script>
        <segment name="Fortran" id="716770763" classid="CoreSegment"><![CDATA[#IF Dim==1
      $B = $A($Index)
#ELSE
      $B = $A($Index : $End)
#ENDIF]]></segment>
        <segment name="Checks" id="1221891411" classid="CoreSegment"><![CDATA[ERROR Dimension input must be greater than 0 : Dim > 0
ERROR Output array index exceeds input array bounds : $#DIM(A) >= End]]></segment>
        <segment name="Computations" id="1358114798" classid="CoreSegment"><![CDATA[INTEGER End = Index + Dim - 1]]></segment>
        <segment name="FlyBy" id="457836472" classid="CoreSegment"><![CDATA[Datatap
:A
Array input
:B
Output]]></segment>
      </script>
