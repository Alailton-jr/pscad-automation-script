            <help><![CDATA[Starting index of sub-array or the index of the scalar output]]></help>
          </parameter>
          <parameter type="Integer" name="Dim" desc="Dimension (Enter 1 for Scalar)" content_type="Literal" min="1" max="999" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Choice" name="Type" desc="Input Data Type" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[2]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select from Logical, Integer, Real or Complex]]></help>
            <choice><![CDATA[0 = Logical]]></choice>
            <choice><![CDATA[1 = Integer]]></choice>
            <choice><![CDATA[2 = Real]]></choice>
            <choice><![CDATA[3 = Complex]]></choice>
          </parameter>
          <parameter type="Choice" name="Style" desc="Line Style" group="" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select straight line or arc]]></help>
            <choice><![CDATA[0 = Straight Line]]></choice>
            <choice><![CDATA[1 = Arc]]></choice>
          </parameter>
          <parameter type="Choice" name="Disp" desc="Display Index?" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[1]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select Yes to display index]]></help>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
