      <script>
        <segment name="Fortran" id="1060819517" classid="CoreSegment"><![CDATA[! Channel Decoder
#IF DPath==0
      $OUT = 0
#ELSEIF DPath==1
      $OUT = 0.0
#ELSEIF DPath==2
      $OUT = CMPLX(0.0,0.0)
#ENDIF
      IF (($Select .LE. $Dim).AND.($Select .GT. 0)) THEN
        $OUT($Select) = $Data
      ENDIF]]></segment>
        <segment name="FlyBy" id="127452041" classid="CoreSegment"><![CDATA[N Chnanel Multiplexer
:Out
Output - 12 element array
:Selct
Select
:Data
Data]]></segment>
      </script>
