    <Definition classid="UserCmpDefn" name="current_scaler_2" url="" view="false" instances="0" date="0" crc="72728609" id="1053003236" group="">
      <paramlist name="">
        <param name="Description" value="Current Scaling" />
      </paramlist>
      <script>
        <segment name="Dsdyn" id="2145053017" classid="CoreSegment"><![CDATA[#BEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL MNA_CDCS(($G_CDCS-1.0),$#M[1] )
 #IF Dim==3
      CALL MNA_CDCS(($G_CDCS-1.0),$#M[2] )
      CALL MNA_CDCS(($G_CDCS-1.0),$#M[3] )
 #ENDIF  
#ENDBEGIN]]></segment>
        <segment classid="CoreSegment" id="937945290" name="MANA"><![CDATA[#MELEMENT         $(Dim)
#MBRANCHES        2
! mna element with two branches
2
MBR1 = $A(1)  $B(1)
MBR2 = $B(1)  $G(1)
#IF Dim==3
2
MBR3 = $A(2)  $B(2)
MBR4 = $B(2)  $G(2)
2
MBR5 = $A(3)  $B(3)
MBR6 = $B(3)  $G(3)
#ENDIF]]></segment>
        <segment classid="CoreSegment" id="321900765" name="FlyBy"><![CDATA[Current Scalar
:A
Current measurement side
:B
Scaled current side]]></segment>
      </script>
